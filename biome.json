{
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noUnknownAtRules": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!tests/fixtures",
      "!lib/server/fixtures",
      "!tmp",
      "!tsconfig.tsbuildinfo",
      "!dist",
      "!test-results",
      "!playwright-report",
      "!.data"
    ]
  }
}
